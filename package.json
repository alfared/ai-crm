{
  "name": "ai-crm",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered CRM built with NestJS, React and TypeScript",
  "scripts": {
    "dev": "concurrently -n API,WEB \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter frontend dev",
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter frontend build",
    "start:api": "pnpm --filter api start:prod"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
